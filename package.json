{
  "name": "editora-peru-totem",
  "productName": "Tótem Editora Perú",
  "version": "0.2.54",
  "description": "Sistema interactivo para tótem digital de Editora Perú",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "publicador": "node scripts/publicador-dev.mjs",
    "publicador:paquete": "node scripts/package-publicador.mjs",
    "publicador:verificar": "node scripts/check-publicador.mjs",
    "models": "node scripts/fetch-models.mjs",
    "reset-data": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/reset-data.mjs",
    "test:e2e": "electron-vite build && node --no-warnings tests/e2e/run.mjs",
    "dist": "node scripts/check-models.mjs && cross-env TOTEM_EMBED_PUBLICATION=1 electron-vite build && node scripts/check-built-publication.mjs && electron-builder --win --x64 && node scripts/check-package.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "^1.30.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
